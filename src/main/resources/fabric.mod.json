{
	"schemaVersion": 1,
	"id": "madoku-craft-items",
	"version": "${version}",
	"name": "Madoku Craft: Items",
	"description": "A configurable Item overhaul system.",
	"authors": [
		"Me!"
	],
	"contact": {
